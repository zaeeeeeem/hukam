# Gemma 4 through the Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it
# Or use Vertex AI with your gcloud login (used when GEMINI_API_KEY is empty)
VERTEX_PROJECT=

# WhatsApp MCP daemon (github.com/Sealjay/mcp-whatsapp), HTTP MCP endpoint
WA_DAEMON=http://127.0.0.1:8766/mcp
# Comma-separated allowlist of phone numbers (E.164 digits, no +). Everyone else is ignored.
WA_ALLOW=

# Superset workspace the agents run in
HUKAM_WORKSPACE=

# DNotifier realtime (optional, powers the live dashboard). Dev only: the dashboard runs on localhost.
DNOTIFIER_APP_ID=
DNOTIFIER_SECRET=

DASHBOARD_PORT=4747
HUKAM_CLAUDE_MODEL=sonnet
