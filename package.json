{
  "name": "hukam",
  "version": "1.0.0",
  "description": "Command your coding agents from WhatsApp. Gemma 4 routes, Superset runs, DNotifier streams.",
  "main": "index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/router.mjs",
    "portal:install": "npm --prefix portal install",
    "portal:build": "npm --prefix portal run build",
    "portal:dev": "npm --prefix portal run dev",
    "check": "for f in src/*.mjs; do node --check $f || exit 1; done && npm --prefix portal run typecheck",
    "playground": "node scripts/serve-playground.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "type": "module",
  "dependencies": {
    "@dnotifier-realtime/dnotifier": "^1.1.25",
    "ws": "^8.22.0"
  }
}
